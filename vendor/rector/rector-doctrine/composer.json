{
    "name": "rector\/rector-doctrine",
    "type": "rector-extension",
    "license": "MIT",
    "description": "Rector upgrades rules for Doctrine",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "doctrine\/doctrine-bundle": "^3.3",
        "doctrine\/orm": "^3.7",
        "symplify\/easy-coding-standard": "^13.2",
        "phpstan\/extension-installer": "^1.4",
        "phpstan\/phpstan": "^2.3",
        "phpstan\/phpstan-deprecation-rules": "^2.0",
        "phpstan\/phpstan-webmozart-assert": "^2.0",
        "phpunit\/phpunit": "^13.3",
        "rector\/jack": "^1.1",
        "rector\/rector-src": "dev-main",
        "rector\/swiss-knife": "^2.7",
        "symplify\/phpstan-rules": "^14.13",
        "tomasvotruba\/class-leak": "^2.3",
        "tomasvotruba\/type-coverage": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Rector\\Doctrine\\": [
                "src",
                "rules"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rector\\Doctrine\\Tests\\": [
                "tests",
                "rules-tests"
            ]
        },
        "classmap": [
            "stubs"
        ]
    },
    "scripts": {
        "phpstan": "vendor\/bin\/phpstan analyse --ansi",
        "duplicated-code": "vendor\/bin\/swiss-knife duplicated-code src rules --min-tokens 100 --min-lines 5",
        "rector": "vendor\/bin\/rector --ansi",
        "check-cs": "vendor\/bin\/ecs check --ansi",
        "fix-cs": "vendor\/bin\/ecs check --fix --ansi"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "rector\/extension-installer": true,
            "phpstan\/extension-installer": true
        }
    }
}